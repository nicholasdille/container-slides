{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": {},
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": [
        "kubernetes-mcp-server"
      ],
      "enabled": true
    },
    "grafana": {
      "type": "local",
      "command": [
        "mcp-grafana"
      ],
      "enabled": true
    }
  }
}